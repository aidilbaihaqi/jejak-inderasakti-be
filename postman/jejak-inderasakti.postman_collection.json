{
  "info": {
    "name": "Jejak Inderasakti API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "REST contract from contracts/openapi.yaml. The host token is fetched automatically; ids, PIN and tokens are stored in the environment by test scripts. Run Auth then Rooms top-to-bottom for a full flow."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{host_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login: fetch a host JWT when missing or about to expire (<60s left).",
          "const isPublic = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (isPublic) return;",
          "",
          "const exp = Number(pm.environment.get('host_token_exp') || 0);",
          "if (pm.environment.get('host_token') && exp - Date.now() / 1000 > 60) return;",
          "",
          "const email = pm.environment.get('host_email');",
          "const password = pm.environment.get('host_password');",
          "if (!email || !password) { throw new Error('Set host_email and host_password in the environment'); }",
          "",
          "pm.sendRequest({",
          "  url: pm.environment.get('base_url') + '/api/auth/login', method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: { mode: 'raw', raw: JSON.stringify({ email, password }) }",
          "}, (err, res) => {",
          "  if (err || res.code !== 200) { console.error('Auto-login failed', err || res.text()); return; }",
          "  const t = res.json().token;",
          "  const payload = JSON.parse(atob(t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
          "  pm.environment.set('host_token', t);",
          "  pm.environment.set('host_token_exp', payload.exp);",
          "});"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response time < 300ms', () => pm.expect(pm.response.responseTime).to.be.below(300));",
          "if (pm.response.code >= 400) {",
          "  pm.test('error body has code + message', () => {",
          "    const b = pm.response.json();",
          "    pm.expect(b).to.have.property('code');",
          "    pm.expect(b).to.have.property('message');",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Healthz",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/healthz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "healthz"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{host_email}}\",\n  \"password\": \"{{host_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().token;",
                  "pm.test('token is a JWT', () => pm.expect(t.split('.')).to.have.length(3));",
                  "const payload = JSON.parse(atob(t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.environment.set('host_token', t);",
                  "pm.environment.set('host_token_exp', payload.exp);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{host_email}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error code is UNAUTHORIZED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Rooms",
      "item": [
        {
          "name": "Create room",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rooms",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rooms"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jenjang\": \"SD\",\n  \"short_session\": false,\n  \"accuracy_mode\": false,\n  \"consent_confirmed\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('pin is 6 digits', () => pm.expect(b.pin).to.match(/^[0-9]{6}$/));",
                  "pm.test('has id and qr_url', () => { pm.expect(b.id).to.be.a('string'); pm.expect(b.qr_url).to.be.a('string'); });",
                  "pm.environment.set('room_id', b.id);",
                  "pm.environment.set('pin', b.pin);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create room - no auth",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rooms",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rooms"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jenjang\": \"SD\",\n  \"consent_confirmed\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error code is UNAUTHORIZED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get room by PIN",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rooms/{{pin}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rooms",
                "{{pin}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('shape', () => {",
                  "  pm.expect(b.status).to.be.oneOf(['lobby', 'running']);",
                  "  pm.expect(b.slots_left).to.be.within(0, 15);",
                  "  pm.expect(b.jenjang).to.be.oneOf(['SD', 'SMP', 'SMA']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get room - unknown PIN",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rooms/000000",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rooms",
                "000000"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code is ROOM_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('ROOM_NOT_FOUND'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Join room",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rooms/{{pin}}/join",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rooms",
                "{{pin}}",
                "join"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"{{nickname}}\",\n  \"school_id\": null,\n  \"jenjang\": \"SD\",\n  \"avatar\": 1,\n  \"lang\": \"id\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('nickname', 'P' + Math.floor(1000 + Math.random() * 9000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().player_token;",
                  "pm.test('player_token present', () => pm.expect(t).to.be.a('string').and.not.empty);",
                  "pm.environment.set('player_token', t);"
                ]
              }
            }
          ]
        },
        {
          "name": "Join room - nickname taken",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rooms/{{pin}}/join",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rooms",
                "{{pin}}",
                "join"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"{{nickname}}\",\n  \"school_id\": null,\n  \"jenjang\": \"SD\",\n  \"avatar\": 1,\n  \"lang\": \"id\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Run right after 'Join room': it re-uses the same nickname."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('error code is NICKNAME_TAKEN', () => pm.expect(pm.response.json().code).to.eql('NICKNAME_TAKEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Export results CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/rooms/{{room_id}}/results.csv",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rooms",
                "{{room_id}}",
                "results.csv"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('is CSV', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Schools",
      "item": [
        {
          "name": "Search schools",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/schools?q=sekolah",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "schools"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "sekolah"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('is array of schools', () => { pm.expect(list).to.be.an('array'); list.forEach(s => pm.expect(s).to.have.property('name')); });",
                  "if (list.length) pm.environment.set('school_id', list[0].id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Leaderboard",
      "item": [
        {
          "name": "School leaderboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/leaderboard/schools",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leaderboard",
                "schools"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}