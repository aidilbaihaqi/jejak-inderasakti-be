# Caddy obtains and renews TLS certificates for APP_DOMAIN and API_DOMAIN automatically
# (Let's Encrypt). Both A records must point at this host and ports 80/443 must be reachable.
#
# APP_DOMAIN (the Next.js frontend) and API_DOMAIN (this repo's REST + WebSocket API) are two
# separate sites so each gets its own certificate; both are served by this single Caddy instance.
# The frontend container ("web") is started by the jejak-inderasakti-fe stack and joins the same
# external Docker network as this stack — see deploy/README.md.

{$APP_DOMAIN} {
	encode gzip zstd

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	reverse_proxy web:3000
}

{$API_DOMAIN} {
	encode gzip zstd

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# WebSocket (Caddy upgrades the connection automatically)
	handle /ws {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy api:8080
	}
}
