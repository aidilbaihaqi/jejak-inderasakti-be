# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit real values.

# Public hostnames Caddy serves. Both need an A record pointing at this server.
APP_DOMAIN=penyengatadventure.tech      # the Next.js frontend (jejak-inderasakti-fe)
API_DOMAIN=api.penyengatadventure.tech  # this repo's REST + WebSocket API

# The frontend's origin. Used to build QR/join links (PUBLIC_BASE_URL) and to allow it through
# CORS and the WebSocket origin check (CORS_ALLOWED_ORIGINS, comma-separated if there is more than
# one — e.g. also allow "https://www.penyengatadventure.tech" if that redirects to the apex).
PUBLIC_BASE_URL=https://penyengatadventure.tech
CORS_ALLOWED_ORIGINS=https://penyengatadventure.tech

# Generate with: openssl rand -hex 24   (hex only, so it is safe inside the DATABASE_URL)
POSTGRES_USER=jejak
POSTGRES_PASSWORD=
POSTGRES_DB=jejak_inderasakti

# Generate with: openssl rand -hex 32   (at least 32 characters)
JWT_SECRET=

LOG_LEVEL=info
RATE_LIMIT_JOIN_PER_MIN=10

# Optional overrides
HTTP_PORT=80
HTTPS_PORT=443
