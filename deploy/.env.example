# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit real values.

# Public hostname served by Caddy (an A record must point at this server)
DOMAIN=staging.jejak.example.id

# Generate with: openssl rand -hex 24   (hex only, so it is safe inside the DATABASE_URL)
POSTGRES_USER=jejak
POSTGRES_PASSWORD=
POSTGRES_DB=jejak_inderasakti

# Generate with: openssl rand -hex 32   (at least 32 characters)
JWT_SECRET=

LOG_LEVEL=info
RATE_LIMIT_JOIN_PER_MIN=10

# Optional overrides
HTTP_PORT=80
HTTPS_PORT=443
WEB_DIST_DIR=./web-dist
